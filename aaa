        ["embeds"] = {{
            ["title"] = "🎉 Secret Hatch Detected!",
            ["color"] = 65280,
            ["fields"] = {
                {["name"] = "Pet", ["value"] = tostring(petName), ["inline"] = true},
                {["name"] = "Egg", ["value"] = tostring(eggName), ["inline"] = true},
                {["name"] = "Chance", ["value"] = tostring(chance), ["inline"] = true}
            },
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(function()
        request({
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

